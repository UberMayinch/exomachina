#!/bin/sh
# exomachina launcher (needs Emacs 29+).
#
#   exomachina [--vault DIR] [EMACS-ARGS...]   open Emacs (GUI, or -nw for terminal)
#   exomachina [--vault DIR] start             headless: background daemon, keeps
#                                              running after you log out / ssh drops
#   exomachina [--vault DIR] attach            terminal UI on the daemon (starts it)
#   exomachina status | stop
#   exomachina send MODALITY KIND VALUE        input event to the daemon (or `send -`)
#   exomachina pull                            fetch models + memory weights (first run)
#
# The vault is where memory, chord stats, feedback and your self layer live.
# Order: --vault, then $EXO_VAULT, then $XDG_DATA_HOME/exomachina.
#
# Per-machine settings go in ${XDG_CONFIG_HOME:-~/.config}/exomachina/env
# (shell syntax), e.g.
#   EXO_VAULT=/srv/me/vault
#   EXO_EMACS=$HOME/emacs/src/emacs
#   EXO_NAME=exomachina          # daemon name, one per vault
#   EXO_MODELS="qwen3:8b qwen2.5-coder:1.5b"   # what `pull` fetches
#
# Sockets (Emacs server + input bridge) live in a per-user 0700 directory
# that outlives login sessions: ${XDG_STATE_HOME:-~/.local/state}/exomachina/run.
# $XDG_RUNTIME_DIR is not used: it vanishes when your last ssh session
# closes, which would orphan a headless daemon.
set -e
here=$(cd "$(dirname "$0")/.." && pwd)
conf="${XDG_CONFIG_HOME:-$HOME/.config}/exomachina/env"
# shellcheck disable=SC1090
if [ -f "$conf" ]; then set -a; . "$conf"; set +a; fi
[ -d "$HOME/.local/bin" ] && PATH="$HOME/.local/bin:$PATH"   # uv, user-local ollama
export PATH

if [ "$1" = "--vault" ]; then
  [ -n "$2" ] || { echo "exomachina: --vault needs a directory" >&2; exit 2; }
  EXO_VAULT=$2; shift 2
fi
if [ -n "$EXO_VAULT" ]; then
  mkdir -p "$EXO_VAULT" && chmod 700 "$EXO_VAULT"
  EXO_VAULT=$(cd "$EXO_VAULT" && pwd)
  export EXO_VAULT
fi

emacs=${EXO_EMACS:-emacs}
name=${EXO_NAME:-exomachina}
host=$(uname -n | cut -d. -f1)   # shared homes: one socket per machine
run="${XDG_STATE_HOME:-$HOME/.local/state}/exomachina/run"
mkdir -p "$run" && chmod 700 "$run" "$run/.."
server="$run/$name@$host"
EXO_SOCKET=${EXO_SOCKET:-"$run/$name@$host.input"}
export EXO_NAME="$name" EXO_SOCKET
client=${EXO_EMACSCLIENT:-}
if [ -z "$client" ]; then
  d=$(dirname "$(command -v "$emacs" || echo "$emacs")")
  for c in "$d/emacsclient" "$d/../lib-src/emacsclient"; do
    [ -x "$c" ] && client=$c && break
  done
  : "${client:=emacsclient}"
fi

ensure_ollama() {
  command -v ollama >/dev/null 2>&1 || return 0
  ollama_up && return 0
  nohup ollama serve >"$run/../ollama.log" 2>&1 </dev/null &
}

ollama_up() {
  o=${OLLAMA_HOST:-http://localhost:11434}
  case $o in http*) ;; *) o=http://$o ;; esac
  curl -s -m 1 "$o/api/version" >/dev/null 2>&1
}

ec() { "$client" -s "$server" "$@"; }
running() { ec --eval t >/dev/null 2>&1; }

start() {
  if running; then
    if [ -n "$EXO_VAULT" ]; then
      v=$(ec --eval 'exo-data-directory' 2>/dev/null | tr -d '"')
      [ "${v%/}" = "$EXO_VAULT" ] || echo "exomachina: warning: daemon '$name' is already running on vault $v, not $EXO_VAULT (stop it, or use another EXO_NAME)" >&2
    fi
    return 0
  fi
  ensure_ollama
  echo "exomachina: starting headless daemon '$name' (vault: ${EXO_VAULT:-default})" >&2
  "$emacs" --init-directory="$here" --daemon="$server"
}

pull() {
  ensure_ollama
  i=0; until ollama_up; do i=$((i+1)); [ $i -gt 30 ] && { echo "exomachina: ollama did not start" >&2; exit 1; }; sleep 1; done
  for m in ${EXO_MODELS:-qwen3:8b qwen2.5-coder:1.5b}; do ollama pull "$m"; done
  if command -v uv >/dev/null 2>&1; then
    echo "exomachina: fetching memory model deps + weights (once, several GB)…" >&2
    log="$run/../exo-embed-warm.log"
    "$here/bin/exo-embed" --port 0 >"$log" 2>&1 &
    pid=$!
    until grep -q "exo-embed: .* on 127" "$log" 2>/dev/null; do
      kill -0 $pid 2>/dev/null || { tail -5 "$log" >&2; echo "exomachina: memory sidecar failed" >&2; exit 1; }
      sleep 2
    done
    kill $pid; echo "exomachina: memory model ready" >&2
  else
    echo "exomachina: no uv: memory falls back to text-only Ollama (set exo-memory-backend 'ollama; ollama pull embeddinggemma-2)" >&2
  fi
}

case $1 in
  start) start ;;
  pull) pull ;;
  attach)
    start
    exec "$client" -s "$server" -t ;;
  status)
    if running; then
      ec --eval \
        '(format "running: vault %s, memories %d, sidecar %s, bridge %s"
                 exo-data-directory (length (exo-memory-load))
                 (if (bound-and-true-p exo-memory--sidecar-ready) "ready" "idle")
                 exo-bridge-socket)'
    else echo "not running"; exit 1; fi ;;
  stop)
    running && ec --eval '(kill-emacs)' >/dev/null 2>&1 || true
    echo "stopped" ;;
  send)
    shift
    exec "$here/bin/exo-send" "$@" ;;
  *)
    ensure_ollama
    exec "$emacs" --init-directory="$here" "$@" ;;
esac
