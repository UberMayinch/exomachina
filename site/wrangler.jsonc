{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exomachina",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "exomachina-waitlist",
      // replace with id from `wrangler d1 create exomachina-waitlist`
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
  // Enable once exomachina.si is a Cloudflare zone:
  // "routes": [
  //   { "pattern": "exomachina.si", "custom_domain": true },
  //   { "pattern": "www.exomachina.si", "custom_domain": true }
  // ]
}
